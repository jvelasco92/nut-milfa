# Copiar este archivo a .streamlit/secrets.toml y completar con tus datos reales.
# .streamlit/secrets.toml NUNCA debe subirse a un repositorio público (agregalo a .gitignore).

# Cadena de conexión a la base de datos PostgreSQL de Supabase.
# La obtenés en: Supabase > Project Settings > Database > Connection string > URI
# (usar el modo "Session pooler" o "Transaction pooler" para Streamlit Cloud).
DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Usuarios habilitados para ingresar a la app (las 2 nutricionistas).
[auth.users]
maria = "CambiarEstaClave123!"
lucia = "CambiarEstaOtraClave456!"
